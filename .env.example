# Public API listener. Network exposure is deployment policy.
REC_LIVE_HOST=0.0.0.0
REC_LIVE_PORT=8787

# Private state and media locations on the target host.
REC_LIVE_DATA_DIR=/var/lib/rec-live-tronic
REC_LIVE_RECORDINGS_DIR=/srv/rec-live-tronic/recordings
REC_LIVE_PRIVATE_SOCKET=/run/rec-live-tronic/api.sock

# Root-managed executable used by the reconciler.
REC_LIVE_STREAMLINK_BIN=/usr/local/bin/streamlink
REC_LIVE_RECONCILE_INTERVAL_SECONDS=30
REC_LIVE_RUNTIME_SAFETY_SECONDS=120
REC_LIVE_STOP_TIMEOUT_SECONDS=30
