{
  "name": "rec-live-tronic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "build:client": "vite build",
    "dev": "npm run build && node --watch dist/server.js",
    "dev:client": "vite dev",
    "start": "node dist/server.js",
    "test": "npm run build && tap --disable-coverage test/functional/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "reconcile:once": "node dist/reconciler/main.js",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "express": "5.2.1",
    "mpegts.js": "^1.8.0",
    "multer": "2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "tap": "21.7.4",
    "typescript": "5.9.3",
    "vite": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  }
}
